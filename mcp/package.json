{
  "name": "@deal/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the procurement layer: AI agents find services and run escrowed deals on Solana.",
  "bin": {
    "deal-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --import tsx --test test/*.test.ts && node scripts/build.mjs && node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "@deal/agents": "file:../agents",
    "@deal/chain": "file:../chain",
    "@deal/core": "file:../core",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@noble/hashes": "^2.4.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@solana/kit-plugin-litesvm": "^0.19.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "litesvm": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
